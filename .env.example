# OKH-RAG — LLM / embedding backend credentials
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env            (bash / WSL)
#     Copy-Item .env.example .env     (PowerShell)
#
# The `openai` SDK (src/okh_rag/llm/openai_client.py) reads these two variables
# directly from the environment, so credentials never enter configs/base.yaml.
# A repo-root `.env` is loaded automatically (python-dotenv, see requirements.txt);
# variables exported in the shell take precedence over this file.
# Whichever relay/proxy you point OPENAI_BASE_URL at MUST serve BOTH models
# referenced by the paper:
#   - gpt-4o                       (§4.1 generator, §A.2 extraction, §4.1 judge)
#   - text-embedding-3-small       (§A.4 — hyperedge embeddings, R^1536)
#
# Manual loading is only needed if you skip the .env file.
#
# PowerShell (per-session):
#     $env:OPENAI_API_KEY = "sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
#     $env:OPENAI_BASE_URL = "https://your-relay.example.com/v1"
#
# bash / WSL (per-session):
#     export OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
#     export OPENAI_BASE_URL="https://your-relay.example.com/v1"

OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://your-relay.example.com/v1

# -----------------------------------------------------------------------------
# Structured-outputs compatibility (relays that do not implement OpenAI's
# strict json_schema Structured Outputs, like the 400 "'response_format' of type
# 'json_schema' is not supported with this model"). Leave unset for auto
# detection (the client downgrades itself on the first 400), or pin the rung:
#   schema = strict json_schema Structured Outputs (official OpenAI; default)
#   object = response_format {"type": "json_object"} + schema in the prompt
#   plain  = no response_format, schema described in the prompt only
# OKH_RAG_RESPONSE_FORMAT=object
